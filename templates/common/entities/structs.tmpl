{{ define "structs" }}

{{- range . }}
  {{ ucfirst (camelcase .Name) }}
  {{- if .NestedTypes }} {{ .Type }} {
    {{ template "structs" .NestedTypes}}
  }

  {{- else }}{{ $omitempty := "" }}{{ if not .Required }}{{ $omitempty = ",omitempty" }}{{ end }} {{ .Type }} `json:"{{ .MarshalName }}{{ $omitempty }}" yaml:"{{ .MarshalName }}{{ $omitempty }}" xml:"{{ .MarshalName }}{{ $omitempty }}" form:"{{ .MarshalName }}"`
  {{- end -}}
{{ end }}

{{- end }}
