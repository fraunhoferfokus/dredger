// Don't edit this file, as it is generated by dredger
package entities

{{ template "imports" .Imports }}

{{ range $SchemaName, $TypeDefs := .SchemaDefs }}
	{{ if len $TypeDefs }}
		{{- $FirstTypeDef := index $TypeDefs 0 }}
		{{- $isSchemaDef := eq $FirstTypeDef.Name $SchemaName }}
        {{ if and $isSchemaDef (eq $FirstTypeDef.Kind "alias") (eq (len $FirstTypeDef.Enum) 0) }}
            type {{ $FirstTypeDef.Name }} {{ $FirstTypeDef.Type }}

            func (v *{{ $FirstTypeDef.Name }}) Validate() error {
                return nil
            }

		{{ else if and $isSchemaDef (eq $FirstTypeDef.Kind "allof") }}
			{{ template "entity_allof" (dict "SchemaName" $SchemaName "Variants" $FirstTypeDef.Variants) }}

		{{ else if and $isSchemaDef (eq $FirstTypeDef.Kind "anyof") }}
			{{ template "entity_anyof" (dict "SchemaName" $SchemaName "Variants" $FirstTypeDef.Variants) }}

		{{ else if and $isSchemaDef (eq $FirstTypeDef.Kind "oneof") }}
			{{ template "entity_oneof" (dict "SchemaName" $SchemaName "Variants" $FirstTypeDef.Variants) }}

        {{ else if not (eq (len $FirstTypeDef.Enum) 0) }}
			{{ template "entity_enum" (dict "SchemaName" $SchemaName "TypeDef" $FirstTypeDef) }}

		{{ else }}
			{{ template "entity_regular" (dict "SchemaName" $SchemaName "TypeDefs" $TypeDefs) }}

		{{ end }}
    {{- else }}
    {{- /* Empty struct */}}
    {{ template "entity_regular" (dict "SchemaName" $SchemaName "TypeDefs" $TypeDefs) }}

	{{ end }}
{{ end }}
